# Los secretos van acá, no en el YAML. El compose los inyecta como variables de
# entorno y copilot.yaml las referencia con ${VAR}.

# Token para /v1/*. Generalo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COPILOT_API_TOKEN=

# El TSDB del cliente. En el compose de desarrollo apunta al de juguete.
PROMETHEUS_URL=http://prometheus:9090

# Endpoint compatible con OpenAI. Lo que ya tenga puesto el cliente.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

COPILOT_LOG_LEVEL=INFO
COPILOT_LOG_FORMAT=text

# Huawei Cloud, si se usan cloudeye / huawei_bss / smn. Credencial de SÓLO
# LECTURA (deploy/iam/huawei-readonly-policy.json). Nunca en el YAML.
HW_AK=
HW_SK=
HW_REGION=la-south-2
HW_BSS_EDITION=intl          # cn para la nube de China
SMN_TOPIC_URN=
